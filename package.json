{
  "name": "rail-island-music",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Generated music for Rail Island, and the catalog site that plays it (music.railisland.com)",
  "scripts": {
    "build:music": "tsx generator/generate.ts",
    "dev": "pnpm build:music && vite",
    "build": "pnpm build:music && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "abcjs": "^6.4.4",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
