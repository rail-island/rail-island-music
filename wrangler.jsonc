{
  "$schema": "node_modules/wrangler/config-schema.json",
  // music.railisland.com: an assets-only Worker (no script, no bindings, no
  // vars) that serves `pnpm build`'s output -- the catalog site plus the
  // generated music it plays. Deployed from `master` by
  // .github/workflows/deploy.yml. See docs/guide/deploy.md.
  "name": "rail-island-music",
  "compatibility_date": "2026-06-16",
  "assets": {
    "directory": "./dist",
    // The site keeps its state in the query string of one page, so any unknown
    // path falls back to index.html rather than a 404.
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "music.railisland.com", "custom_domain": true }
  ]
}
